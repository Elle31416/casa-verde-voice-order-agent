{
  "name": "casa-verde-voice-order-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "phone": "node scripts/connect-phone.mjs",
    "phone:status": "node scripts/connect-phone.mjs --status",
    "test": "node scripts/test-telephony.mjs",
    "serve": "npm run build && node server/index.mjs",
    "deploy:docs": "GITHUB_PAGES=true vite build && rm -rf docs && cp -r dist docs && touch docs/.nojekyll"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0"
  },
  "description": "Casa Verde — a voice AI host that takes restaurant orders and builds the kitchen ticket live, in the browser and on a Twilio SIP phone number."
}
