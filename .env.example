# AssemblyAI Voice Agent API key. Powers the browser session, the stored
# agents, and the phone number.
ASSEMBLYAI_API_KEY=your_key_here
# Optional: pin an existing browser agent id, otherwise the server creates/updates one by name
# AGENT_ID=
# Optional: pin the phone agent id; otherwise it is created/updated by name.
# PHONE_AGENT_ID=

# Authenticates the phone agent's remote tools (/menu, /order, /payment, /receipt).
# Use a long random value. Never commit the real value.
SHARED_SECRET=replace_with_a_long_random_secret
# Set true to enable the phone-agent configuration path.
REQUIRE_PHONE_AUTH=false
# Optional strict mode: set true to refuse startup when the phone secret is missing.
FAIL_ON_MISSING_PHONE_SECRET=false

# Public HTTPS origin used in the phone agent tool URLs and Twilio webhook.
# Example: https://casa-verde.example.com or an https ngrok URL for a demo.
# On Render this is derived automatically from RENDER_EXTERNAL_URL; set it only
# for local tunnels or custom domains.
PUBLIC_URL=https://YOUR_BACKEND_URL
# Optional: separate public backend URL for AssemblyAI tool callbacks.
# PHONE_BACKEND_URL=https://YOUR_BACKEND_URL

# ---------------------------------------------------------------------------
# Phone transport A (recommended): AssemblyAI SIP telephony.
#
#   Caller → your Twilio number → SIP trunk → sip:sip.assemblyai.com → agent
#
# There is no media server, audio bridge, or inbound webhook to run: Twilio
# hands the call to AssemblyAI over SIP and AssemblyAI runs the stored phone
# agent, which calls this backend's HTTP tools directly. `npm run phone`
# creates the trunk, routes it, attaches the number, registers it with
# AssemblyAI and binds the agent. Every step is idempotent, so re-running it
# is safe.
# https://www.assemblyai.com/docs/voice-agents/voice-agent-api/connect-to-twilio
#
# Never commit these four values.
# Account SID and Auth Token: console.twilio.com, top of the page (the token is
# hidden until you click it).
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A number you already own, in E.164 format.
TWILIO_PHONE_NUMBER=+15551234567
# A name you invent for the SIP trunk. It must end in .pstn.twilio.com and be
# unique across all of Twilio, so include your company name. Do not reuse the
# `acme-agent.pstn.twilio.com` example from the docs — it is taken.
TWILIO_TRUNK_DOMAIN=your-company-agent.pstn.twilio.com
# Optional: repeat the provisioning above on every server start, for a
# deployment that cannot run `npm run phone`. Default false.
# PHONE_AUTO_CONNECT=false

# ---------------------------------------------------------------------------
# Phone transport B (fallback): Twilio media bridge.
#
# Use only for a number that cannot use SIP trunking. Audio then flows through
# this server (/twilio/voice webhook + /twilio/media WebSocket), and the phone
# agent is published with audio/pcmu pinned. Set PHONE_TRANSPORT=bridge to
# select it while SIP credentials are also present.
#
# The account SID + Auth Token pair above also signs inbound webhooks. As an
# alternative you can supply a Twilio API Key SID (SK…) and its secret; the
# server then spends that pair on a REST lookup to read the Auth Token that
# signs webhooks. Never commit either value.
# TWILIO_VOICE_AGENT_ID=your_twilio_voice_agent_id
# TWILIO_API_SECRET=your_twilio_api_secret
# Use a second random value for the WebSocket stream query token when possible.
# TWILIO_STREAM_SECRET=replace_with_another_long_random_secret
# PHONE_TRANSPORT=bridge

# Optional real email delivery. Without these, /receipt creates a mock receipt only.
# RESEND_API_KEY=re_your_key_here
# RECEIPT_FROM_EMAIL=Casa Verde <receipts@example.com>

# Optional split deployment: comma-separated frontend origins allowed to call
# the API cross-origin. Empty = same-origin only (single-service default).
# ALLOWED_ORIGINS=https://your-frontend.onrender.com
# Optional build-time backend URL for a separately hosted static frontend.
# VITE_API_BASE_URL=https://your-backend.onrender.com

# PORT=8787
