# AssemblyAI browser + stored-agent publishing
ASSEMBLYAI_API_KEY=your_key_here
# Optional: pin an existing browser agent id, otherwise the server creates/updates one by name
# AGENT_ID=

# Authenticates the phone agent's remote tools (/menu, /order, /payment, /receipt).
# Use a long random value. Never commit the real value.
SHARED_SECRET=replace_with_a_long_random_secret
# Set true to enable the phone-agent configuration path.
REQUIRE_PHONE_AUTH=false
# Optional strict mode: set true to refuse startup when the phone secret is missing.
FAIL_ON_MISSING_PHONE_SECRET=false

# Public HTTPS origin used in the phone agent tool URLs and Twilio webhook.
# Example: https://casa-verde.example.com or an https ngrok URL for a demo.
# On Render this is derived automatically from RENDER_EXTERNAL_URL; set it only
# for local tunnels or custom domains.
PUBLIC_URL=https://YOUR_BACKEND_URL
# Optional: separate public backend URL for AssemblyAI tool callbacks.
# PHONE_BACKEND_URL=https://YOUR_BACKEND_URL
# Optional: pin an existing phone agent id; otherwise it is created/updated by name.
# PHONE_AGENT_ID=

# Twilio phone bridge. A voice agent credential pair + a published phone agent
# are required to enable /twilio/voice. TWILIO_STREAM_SECRET falls back to
# SHARED_SECRET.
# TWILIO_VOICE_AGENT_ID is the Twilio API Key SID for the voice agent (SK...);
# TWILIO_API_SECRET is that key's secret. The server uses the pair as HTTP
# Basic auth to Twilio's REST API to resolve the account Auth Token that signs
# inbound webhooks — Twilio never signs a webhook with an API key secret.
# Never commit either value.
TWILIO_VOICE_AGENT_ID=your_twilio_voice_agent_id
TWILIO_API_SECRET=your_twilio_api_secret
# Use a second random value for the WebSocket stream query token when possible.
TWILIO_STREAM_SECRET=replace_with_another_long_random_secret

# Optional real email delivery. Without these, /receipt creates a mock receipt only.
# RESEND_API_KEY=re_your_key_here
# RECEIPT_FROM_EMAIL=Casa Verde <receipts@example.com>

# Optional split deployment: comma-separated frontend origins allowed to call
# the API cross-origin. Empty = same-origin only (single-service default).
# ALLOWED_ORIGINS=https://your-frontend.onrender.com
# Optional build-time backend URL for a separately hosted static frontend.
# VITE_API_BASE_URL=https://your-backend.onrender.com

# PORT=8787
