# The only credential this project needs. Powers the stored voice agent and the
# short-lived tokens the browser connects with.
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your_key_here

# Optional: pin an existing agent id. Leave unset and the server creates or
# updates the agent by name on startup, then writes the id back here.
# AGENT_ID=

# Token lifetime, in seconds. Both are optional; the defaults are shown.
#   TOKEN_EXPIRES_IN_SECONDS       1–600. How long the browser has to open the
#                                  WebSocket after fetching the token. Tokens
#                                  are single-use.
#   MAX_SESSION_DURATION_SECONDS   60–10800. How long one voice session may run.
# TOKEN_EXPIRES_IN_SECONDS=300
# MAX_SESSION_DURATION_SECONDS=3600

# Optional: the public HTTPS origin, reported by /api/health and in logs.
# On Render this is derived automatically from RENDER_EXTERNAL_URL; set it only
# for a local tunnel or a custom domain.
# PUBLIC_URL=https://casa-verde.example.com

# Optional split deployment: comma-separated frontend origins allowed to call
# the API cross-origin. Empty = same-origin only (single-service default).
# ALLOWED_ORIGINS=https://your-frontend.onrender.com
# Optional build-time backend URL for a separately hosted static frontend.
# VITE_API_BASE_URL=https://your-backend.onrender.com

# PORT=8787
